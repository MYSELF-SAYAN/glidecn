{
  "name": "glidecn-cli",
  "version": "0.1.8",
  "description": "✨ Drop-in page transitions for React — works with Next.js, Vite, TanStack Router, and more",
  "homepage": "https://glidecn.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYSELF-SAYAN/glidecn.git"
  },
  "type": "module",
  "main": "./dist/index.js",
